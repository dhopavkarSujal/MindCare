// ==========================================
// 1. DATABASE & GENERATOR CONFIGURATION
// ==========================================
datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  STUDENT
  COUNSELOR
  ADMIN
}

enum Sender {
  USER
  ASSISTANT
  SYSTEM
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// ==========================================
// USER / PROFILE
// ==========================================

model User {
  id String @id @default(uuid()) @db.Uuid

  email String  @unique
  name  String?

  // Supabase Auth user ID
  supabaseAuthId String? @unique @db.Uuid

  // Optional user-owned application preferences.
  preferences Json?

  role Role @default(STUDENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations  Conversation[]
  moodLogs       MoodLog[]
  journalEntries JournalEntry[]
  consents       ConsentPreference[]
  appointments   Appointment[]
  counsellorProfile Counsellor?

  @@index([role])
}

// ==========================================
// CHAT CONVERSATION
// ==========================================

model Conversation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  title    String  @default("New Support Session")
  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]

  @@index([userId])
  @@index([updatedAt])
  @@index([userId, isPinned, updatedAt])
}

// ==========================================
// CHAT MESSAGE
// ==========================================

model Message {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid

  sender Sender
  text   String @db.Text

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  analysis AnalysisLog?

  @@index([conversationId])
  @@index([createdAt])
}

// ==========================================
// NLP + SAFETY ANALYSIS
// ==========================================

model AnalysisLog {
  id        String @id @default(uuid()) @db.Uuid
  messageId String @unique @db.Uuid

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Sentiment
  sentiment      String
  sentimentScore Float?

  // Emotion
  emotion      String
  emotionScore Float?

  // Intent
  intent String

  // Safety
  riskLevel RiskLevel @default(LOW)
  isCrisis  Boolean   @default(false)
  riskScore Float?

  // Overall model confidence
  confidence Float?

  // Optional complete AI response
  rawResponse Json?

  createdAt DateTime @default(now())

  @@index([emotion])
  @@index([intent])
  @@index([riskLevel])
  @@index([createdAt])
}

// ==========================================
// MOOD TRACKING
// ==========================================

model MoodLog {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  score Int
  note  String? @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ==========================================
// SELF-HELP RESOURCES
// ==========================================

model Resource {
  id String @id @default(uuid()) @db.Uuid

  title       String
  category    String
  content     String  @db.Text
  externalUrl String?

  createdAt DateTime @default(now())

  @@index([category])
}

// ==========================================
// PRIVATE JOURNAL
// ==========================================

model JournalEntry {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  title   String
  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// ==========================================
// PRIVACY AND APP CONSENT PREFERENCES
// ==========================================

model ConsentPreference {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  permission String
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}


// ==========================================
// COUNSELLING AND APPOINTMENTS
// ==========================================

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  COMPLETED
}

model Counsellor {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @unique @db.Uuid
  name      String
  specialty String?
  bio       String?  @db.Text
  avatarUrl String?
  timeZone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  availabilitySlots AvailabilitySlot[]
  appointments     Appointment[]

  @@index([isActive, name])
}

model AvailabilitySlot {
  id           String   @id @default(uuid()) @db.Uuid
  counsellorId String   @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  isAvailable  Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  counsellor   Counsellor   @relation(fields: [counsellorId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([counsellorId, startsAt])
  @@index([counsellorId, isActive, startsAt])
}

model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  counsellorId String            @db.Uuid
  slotId       String            @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  status       AppointmentStatus @default(PENDING)
  reason       String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  counsellor Counsellor       @relation(fields: [counsellorId], references: [id], onDelete: Restrict)
  slot       AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@index([userId, startsAt])
  @@index([counsellorId, startsAt])
  @@index([status, startsAt])
}
