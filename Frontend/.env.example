# Express API base URL INCLUDING the /api prefix, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Supabase: browser-safe project URL + publishable (anon) key ONLY.
# Never put the service-role key or any backend secret in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Canonical origin used for metadata and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
