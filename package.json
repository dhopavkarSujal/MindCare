{
  "name": "mindcare-ai",
  "private": true,
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n AI,BACKEND,FRONTEND \"npm run dev:ai\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:ai": "cd AI-Service && python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:backend": "cd Backend && npm run dev",
    "dev:frontend": "cd Frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}